<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: gray;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chili.java_media_player.Controller">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <top>
        <VBox spacing="10">
            <!-- Navbar -->
            <MenuBar fx:id="menuBar">
                <Menu text="File">
                    <MenuItem onAction="#onFileOpen" text="Open" />
                    <MenuItem onAction="#onFileExit" text="Exit" />
                </Menu>

                <Menu text="Settings">
                    <MenuItem onAction="#onSettingsPreferences" text="Preferences" />
                    <MenuItem onAction="#onSettingsAbout" text="About" />
                </Menu>
            </MenuBar>

            <VBox alignment="CENTER" spacing="20.0">
                <ProgressIndicator fx:id="testProgressBar" progress="0.0" />
                <Label fx:id="welcomeText" />
                <Button onAction="#onHelloButtonClick" text="Hello Software Design class of Fall 2025" />
            </VBox>
        </VBox>
    </top>


    <center>
        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="statusLabel" text="Main content here" />

            <HBox alignment="CENTER" spacing="20">
                <StackPane fx:id="dropArea" prefHeight="200" prefWidth="400" style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: lightgray;">
                    <Label fx:id="audioFileLabel" text="Drag your audio file here" />
                </StackPane>

                <VBox alignment="CENTER">
                    <Label text="Volume" />
                    <Slider fx:id="volumeSlider" orientation="VERTICAL" prefHeight="150" showTickLabels="true" showTickMarks="true" value="50" />
                </VBox>
            </HBox>
        </VBox>
    </center>



    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
            <Button fx:id="playButton" onAction="#onPlayClick" text="Play" />
            <Button fx:id="replayButton" onAction="#replayClick" text="Replay" />
            <Button fx:id="shuffleButton" onAction="#shuffleClick" text="Shuffle" />
        </HBox>
    </bottom>

</BorderPane>
