<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chili.java_media_player.Controller"
            style="-fx-background-color: gray;">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <top>
        <VBox spacing="10">
            <!-- Navbar -->
            <MenuBar fx:id="menuBar">
                <Menu text="File">
                    <MenuItem text="Open" onAction="#onFileOpen"/>
                    <MenuItem text="Exit" onAction="#onFileExit"/>
                </Menu>

                <Menu text="Settings">
                    <MenuItem text="Preferences" onAction="#onSettingsPreferences"/>
                    <MenuItem text="About" onAction="#onSettingsAbout"/>
                </Menu>
            </MenuBar>

            <VBox alignment="CENTER" spacing="20.0">
                <ProgressIndicator fx:id="testProgressBar" progress="0.0" />
                <Label fx:id="welcomeText" />
                <Button onAction="#onHelloButtonClick"
                        text="Hello Software Design class of Fall 2025" />
            </VBox>
        </VBox>
    </top>


    <center>
        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="statusLabel" text="Main content here" />

            <HBox alignment="CENTER" spacing="20">
                <StackPane fx:id="dropArea"
                           style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: lightgray;"
                           prefWidth="400" prefHeight="200">
                    <Label text="Drag your audio file here" />
                </StackPane>

                <VBox alignment="CENTER">
                    <Label text="Volume" />
                    <Slider fx:id="volumeSlider"
                            orientation="VERTICAL"
                            value="50"
                            prefHeight="150"
                            showTickLabels="true"
                            showTickMarks="true" />
                </VBox>
            </HBox>
        </VBox>
    </center>



    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
            <Button fx:id="playButton" text="Play" onAction="#onPlayClick"/>
            <Button fx:id="replayButton" text="Replay" onAction="#replayClick"/>
            <Button fx:id="shuffleButton" text="Shuffle" onAction="#shuffleClick"/>
        </HBox>
    </bottom>

</BorderPane>
