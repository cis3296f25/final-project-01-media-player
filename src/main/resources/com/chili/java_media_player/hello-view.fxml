<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chili.java_media_player.Controller"
            style="-fx-background-color: gray;">
    <left>
        <VBox alignment="TOP_LEFT" spacing="10" style="-fx-padding: 0 10 0 0;">
            <Label text="Playlist" style="-fx-font-size: 14;" />
            <VBox spacing="8" style="-fx-padding: 6 0 6 0;">
                <Button fx:id="replayButton" text="Replay" onAction="#replayClick" prefWidth="200" />
                <Button fx:id="shuffleButton" text="Shuffle" onAction="#shuffleClick" prefWidth="200" />
                <Button text="Remove" onAction="#removeTrackClick" prefWidth="200" />
                <Button text="Clear" onAction="#clearPlaylistClick" prefWidth="200" />
            </VBox>
            <ListView fx:id="playlistListView" prefWidth="200" />
        </VBox>
    </left>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <top>
        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: linear-gradient(#f3f3f3, #e2e2e2); -fx-padding: 6 10; -fx-border-color: #cfcfcf; -fx-border-width: 0 0 1 0;" prefHeight="36" prefWidth="Infinity" maxWidth="Infinity">
                <MenuBar fx:id="menuBar">
                    <Menu text="File">
                        <MenuItem text="Open" onAction="#onFileOpen"/>
                        <MenuItem text="Exit" onAction="#onFileExit"/>
                    </Menu>

                    <Menu text="Settings">
                        <MenuItem text="Preferences" onAction="#onSettingsPreferences"/>
                    </Menu>
                </MenuBar>
                <Button fx:id="aboutButton" text="About" onAction="#onSettingsAbout" style="-fx-background-color: transparent; -fx-padding: 6 12;" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <VBox alignment="CENTER" spacing="20.0">
        <Label fx:id="welcomeText" />
            </VBox>
        </VBox>
    </top>


    <center>
        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="statusLabel" text="" visible="false" managed="false" />

            <HBox alignment="CENTER" spacing="20">
                <StackPane fx:id="dropArea"
                           style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: lightgray;"
                           prefWidth="400" prefHeight="200">
                    <Label text="Drag your audio file here" />
                </StackPane>

                <VBox alignment="CENTER">
                    <Label text="Volume" />
                    <Slider fx:id="volumeSlider"
                            orientation="VERTICAL"
                            value="50"
                            prefHeight="150"
                            showTickLabels="true"
                            showTickMarks="true" />
                </VBox>
            </HBox>

            <Label fx:id="playlistStatusLabel" text="No tracks loaded" style="-fx-font-size: 14; -fx-text-fill: #000000ff;" />


            <!-- Track timeline / seek bar (placeholder, draggable by user but non-functional) -->
            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 6 10 0 10;">
                <Slider fx:id="seekSlider" min="0" max="100" value="0" prefWidth="460" />
                <HBox alignment="CENTER" spacing="8">
                    <Label text="0:00" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="0:00" />
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="2" style="-fx-padding: 0 10 0 10;">
                <Label text="Playback Speed(PLACE HOLDER)" style="-fx-font-size: 11; -fx-text-fill: #000000ff;" />
                <Slider fx:id="speedSlider" min="0.25" max="2.0" value="1.0" blockIncrement="0.25" majorTickUnit="0.25" minorTickCount="0" snapToTicks="true" showTickLabels="true" showTickMarks="true" prefWidth="340" styleClass="speed-slider" />
            </VBox>

            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
                <Button text="◀ Previous" onAction="#previousTrackClick"/>
                <Button fx:id="playButton" text="Play" onAction="#onPlayClick"/>
                <Button text="Next ▶" onAction="#nextTrackClick"/>
            </HBox>
        </VBox>
    </center>



    

    <right>
        <VBox alignment="TOP_CENTER" spacing="12" style="-fx-padding: 8 10 8 10;" prefWidth="240">
            <StackPane prefWidth="220" prefHeight="80" style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: white;">
                <Label text="Spectrogram(PLACEHOLDER)" style="-fx-font-size: 12; -fx-text-fill: #000000ff;" />
            </StackPane>

            <StackPane prefWidth="220" prefHeight="200" style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: #f7f7f7;">
                <Label text="Meta Data(PLACEHOLDER)" style="-fx-font-size: 13; -fx-text-fill: #000000ff;" />
            </StackPane>

            <StackPane prefWidth="220" prefHeight="80" style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: #fafafa;">
                <Label text="Export Options or Credits(PLACEHOLDER)" style="-fx-font-size: 12; -fx-font-style: italic; -fx-text-fill: #000000ff;" wrapText="true" />
            </StackPane>
        </VBox>
    </right>


</BorderPane>
